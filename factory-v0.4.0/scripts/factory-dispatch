#!/usr/bin/env bash
# factory-dispatch — L3 deterministic scheduler: drains ready tickets without
# human scheduling. Human still owns accepted -> land (dispatcher NEVER lands,
# NEVER merges to dev, NEVER pushes).
#
# Usage (run from project root):
#   factory-dispatch once [--dry-run]     single scheduling pass
#   factory-dispatch daemon [--interval 300]   loop until STOP file
#   factory-dispatch status                 show attempts + worktrees
#   factory-dispatch stop|resume            create/remove STOP file
#   factory-dispatch release start [<slug>]   cut integration/<yyyymmdd>-<slug> train from origin/dev
#   factory-dispatch release status           show open train + member branches + head
#   factory-dispatch release merge <ticket>   merge an accepted ticket branch into the train (clean only)
#   factory-dispatch release drop <ticket>    revert a ticket's merge from the train
#   factory-dispatch self-test               hermetic release-mechanics proof (temp bare origin, no gh, no spend)
#
# State: factory/.state/dispatch.db (sqlite, gitignored) + factory/.state/logs/
# Env knobs: MAX_CONCURRENT=1 MAX_ATTEMPTS=2 TIMEOUT_IMPL=1800 TIMEOUT_REVIEW=1200
#            PI_BIN=pi PI_MODEL="" (appended as --model when set)
# Requires: gh (authed), git, sqlite3, timeout, pi (authed, non-interactive ok).
set -euo pipefail

MAX_CONCURRENT="${MAX_CONCURRENT:-1}"
MAX_ATTEMPTS="${MAX_ATTEMPTS:-2}"
TIMEOUT_IMPL="${TIMEOUT_IMPL:-1800}"
TIMEOUT_REVIEW="${TIMEOUT_REVIEW:-1200}"
PI_BIN="${PI_BIN:-pi}"
DRY_RUN=0

ROOT="$PWD"

# gh() wrapper: filters version-manager noise (mise prints to stdout) so
# --jq parsing stays exact. Real errors still surface on stderr.
gh() { command gh "$@" 2>/dev/null | grep -v '^mise ' || true; }
STATE_DIR="$ROOT/factory/.state"
DB="$STATE_DIR/dispatch.db"
LOG_DIR="$STATE_DIR/logs"
STOP_FILE="$STATE_DIR/STOP"
REPO_NAME="$(basename "$ROOT")"

# --- stuck-lease hardening (ticket #75) ------------------------------------
# A dispatcher pass must never die holding a lease on a missing worktree.
# DISPATCH_ATTEMPT_ID names the currently activated attempt row (empty when
# none); the EXIT trap below settles it if the pass dies unsettled. Bash has
# deliberately NO auto-reaper: without a lock a running row might belong to
# a live concurrent pass, so a kill -9 lease is released by the human with
# the printed sqlite3 command instead of by the next pass.
DISPATCH_ATTEMPT_ID=""

lease_recovery_sql() { echo "UPDATE attempts SET status='impl_failed', finished_at=datetime('now') WHERE status LIKE '%_running';"; }

dispatch_lease_trap() {
  local rc=$?
  [ -n "${DISPATCH_ATTEMPT_ID:-}" ] || return "$rc"
  [ -n "${DB:-}" ] && [ -f "$DB" ] || return "$rc"
  local st; st="$(sqlite3 "$DB" "SELECT status FROM attempts WHERE id=$DISPATCH_ATTEMPT_ID;" 2>/dev/null || true)"
  case "$st" in
    *_running)
      sqlite3 "$DB" "UPDATE attempts SET status='impl_failed', finished_at=datetime('now') WHERE id=$DISPATCH_ATTEMPT_ID;" 2>/dev/null || true
      echo "dispatch: pass exited ($rc) with attempt $DISPATCH_ATTEMPT_ID unsettled ($st) — marked impl_failed." >&2
      echo "dispatch: if a lease ever survives a kill -9, release it with:" >&2
      echo "  sqlite3 $DB \"$(lease_recovery_sql)\"" >&2
      ;;
  esac
  return "$rc"
}
trap dispatch_lease_trap EXIT

# ensure_worktree <wt> <branch> <base>: cut or re-attach the ticket
# worktree. Reuses the branch when it already exists; when the branch is
# registered at a directory that no longer exists (a dead retry's admin
# entry — the #60 incident shape), prunes the dead registration and
# re-cuts instead of failing. Reuses the directory in place when it is
# already the branch's checkout. Returns nonzero WITHOUT exiting (callers
# use it in `if !` so `set -e` stays quiet); on failure the ticket is
# released for retry with NO attempt row activated.
ensure_worktree() {
  local wt="$1" branch="$2" base="$3" registered holder wt_abs
  wt_abs="$(cd "$(dirname "$wt")" 2>/dev/null && pwd)/$(basename "$wt")"
  registered="$(git worktree list --porcelain 2>/dev/null | awk -v want="$branch" '
    /^worktree / { path=substr($0, 10) }
    /^branch / { b=$0; sub(/^branch refs\/heads\//, "", b); if (b == want) print path }')"
  if [ -n "${registered:-}" ] && [ "$registered" = "$wt_abs" ] && [ -d "$wt" ]; then
    echo "dispatch: reusing worktree $wt ($branch)" >&2
    return 0
  fi
  if git rev-parse --verify --quiet "$branch" >/dev/null; then
    git worktree add "$wt" "$branch" 2>&1 | tail -n 1 && return 0
  else
    git worktree add "$wt" -b "$branch" "$base" 2>&1 | tail -n 1 && return 0
  fi
  echo "dispatch: worktree add failed for $branch — pruning dead registrations and retrying" >&2
  git worktree prune 2>/dev/null || true
  holder="$(git worktree list --porcelain 2>/dev/null | awk -v want="$branch" '
    /^worktree / { path=substr($0, 10) }
    /^branch / { b=$0; sub(/^branch refs\/heads\//, "", b); if (b == want) print path }')"
  if [ -n "${holder:-}" ] && [ ! -e "$holder" ]; then
    echo "dispatch: stale registration at $holder (directory absent) — removing and re-cutting" >&2
    git worktree remove --force "$holder" 2>/dev/null || true
    git worktree prune 2>/dev/null || true
  fi
  if git rev-parse --verify --quiet "$branch" >/dev/null; then
    git worktree add "$wt" "$branch" 2>&1 | tail -n 1
  else
    git worktree add "$wt" -b "$branch" "$base" 2>&1 | tail -n 1
  fi
}

usage() { sed -n '2,18p' "$0"; }

db_init() {
  mkdir -p "$STATE_DIR" "$LOG_DIR"
  sqlite3 "$DB" "CREATE TABLE IF NOT EXISTS attempts(
    id INTEGER PRIMARY KEY, ticket INTEGER NOT NULL, attempt_no INTEGER NOT NULL,
    base_commit TEXT, head_commit TEXT, worktree TEXT, branch TEXT,
    status TEXT NOT NULL, exit_code INTEGER, log_path TEXT,
    started_at TEXT DEFAULT (datetime('now')), finished_at TEXT);"
  sqlite3 "$DB" "CREATE TABLE IF NOT EXISTS releases(
    id INTEGER PRIMARY KEY, branch TEXT NOT NULL, base_commit TEXT,
    status TEXT NOT NULL DEFAULT 'open',
    created_at TEXT DEFAULT (datetime('now')));"
  # Guarded migration: old rows are unaffected (new column is nullable).
  if [ -z "$(sqlite3 "$DB" "SELECT name FROM pragma_table_info('attempts') WHERE name='train_branch';")" ]; then
    sqlite3 "$DB" "ALTER TABLE attempts ADD COLUMN train_branch TEXT;"
  fi
}

active_count() { sqlite3 "$DB" "SELECT COUNT(*) FROM attempts WHERE status IN ('impl_running','review_running');"; }
ticket_active() { sqlite3 "$DB" "SELECT COUNT(*) FROM attempts WHERE ticket=$1 AND status IN ('impl_running','review_running');"; }
ticket_attempts() { sqlite3 "$DB" "SELECT COUNT(*) FROM attempts WHERE ticket=$1 AND status LIKE '%_done' OR ticket=$1 AND status LIKE '%_failed';"; }
new_attempt() { sqlite3 "$DB" "INSERT INTO attempts(ticket,attempt_no,base_commit,branch,worktree,status,log_path) VALUES($1,$2,'$3','$4','$5','impl_running','$6'); SELECT last_insert_rowid();"; }
set_status() { sqlite3 "$DB" "UPDATE attempts SET status='$2', finished_at=datetime('now') WHERE id=$1;"; }
set_head() { sqlite3 "$DB" "UPDATE attempts SET head_commit='$2', exit_code=$3 WHERE id=$1;"; }
set_train() { sqlite3 "$DB" "UPDATE attempts SET train_branch='$2' WHERE id=$1;"; }
open_train() { [ -f "$DB" ] || return 0; sqlite3 "$DB" "SELECT branch FROM releases WHERE status='open' ORDER BY id DESC LIMIT 1;"; }

issue_json() { gh issue view "$1" --json number,title,body,labels,state 2>/dev/null; }
labels_of() { echo "$1" | python3 -c "import json,sys; print(' '.join(l['name'] for l in json.load(sys.stdin)['labels']))"; }
has_label() { [[ " $1 " == *" $2 "* ]]; }

depends_open() {
  # echo open dependency issue numbers, one per line
  local body="$1"
  echo "$body" | grep -oE "Depends on:.*" | grep -oE "#[0-9]+" | tr -d '#' | while read -r dep; do
    [ -n "$dep" ] && [ "$(gh issue view "$dep" --json state --jq .state 2>/dev/null)" = "OPEN" ] && echo "$dep"
  done || true
  return 0
}

slug_of() {
  echo "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]\+/-/g' | cut -c1-30 | sed 's/^-//;s/-$//'
}

# ---------------------------------------------------------------------------
# RELEASE TRAIN — safety contract (asserted, not just documented):
# The dispatcher NEVER touches dev/main. There is deliberately NO code path
# in this file that pushes, merges into, checks out-and-commits-to, or
# branch-forces dev or main. Trains live on integration/* branches only;
# `git fetch origin dev` below is a read-only fetch. The human owns the
# train → dev review (prompts/review-integration.md) and the land.
# Pushing the train branch itself to origin is a human decision — no
# `git push` appears anywhere in this file.
# Auto-expire rule: exactly one open train is allowed. A new train can only
# start after the old one is merged or abandoned (see cmd_release_start).
# ---------------------------------------------------------------------------

train_worktree() { echo "$(cd "$ROOT/.." && pwd)/${REPO_NAME}-train"; }

ensure_train_worktree() {
  local train="$1" twt; twt="$(train_worktree)"
  if git worktree list --porcelain 2>/dev/null | grep -qF "worktree $twt"; then
    return 0
  fi
  if [ -e "$twt" ]; then echo "release: $twt exists but is not a registered worktree — remove it first" >&2; return 1; fi
  git worktree add "$twt" "$train" 2>&1 | tail -n 1
}

# train_merge <ticket> <ticket-branch> <train>: merge a ticket branch into
# the train worktree with --no-ff --no-edit ONLY. On conflict the merge is
# aborted and nonzero is returned — nothing is ever forced.
train_merge() {
  local ticket="$1" tbranch="$2" train="$3" twt
  twt="$(train_worktree)"
  ensure_train_worktree "$train" || return 1
  git -C "$twt" rev-parse --verify --quiet "$tbranch" >/dev/null || { echo "release: ticket branch $tbranch not found" >&2; return 1; }
  [ -z "$(git -C "$twt" status --porcelain)" ] || { echo "release: train worktree $twt is dirty — refusing" >&2; return 1; }
  if ! git -C "$twt" merge --no-ff --no-edit -m "Merge ticket #${ticket} (${tbranch}) into ${train}" "$tbranch" 2>&1; then
    git -C "$twt" merge --abort 2>/dev/null || true
    echo "release: merge of #$ticket conflicted — aborted, train untouched" >&2
    return 1
  fi
  echo "release: #$ticket merged into $train ($(git -C "$twt" rev-parse --short HEAD))"
}

cmd_release_start() {
  local slug_arg="${1:-}"
  db_init
  local existing; existing="$(open_train)"
  if [ -n "$existing" ]; then
    echo "release: train already open ($existing) — merge or abandon it first; never two open trains" >&2
    exit 1
  fi
  local slug="${slug_arg:-train}"
  slug="$(slug_of "$slug")"
  [ -n "$slug" ] || slug="train"
  local stamp train base
  stamp="$(date +%Y%m%d)"
  train="integration/${stamp}-${slug}"
  if git rev-parse --verify --quiet "$train" >/dev/null; then
    echo "release: branch $train already exists — refusing to reuse" >&2
    exit 1
  fi
  git fetch origin dev --quiet 2>/dev/null || true
  base="$(git rev-parse origin/dev 2>/dev/null || git rev-parse HEAD)"
  git branch "$train" "$base"
  sqlite3 "$DB" "INSERT INTO releases(branch,base_commit,status) VALUES('$train','$base','open');"
  echo "release: train $train cut from $base"
}

cmd_release_status() {
  db_init
  local train; train="$(open_train)"
  if [ -z "$train" ]; then echo "release: no open train"; exit 0; fi
  sqlite3 -header -column "$DB" "SELECT id,branch,substr(base_commit,1,8) AS base,status,created_at FROM releases WHERE status='open';"
  echo "--- member ticket branches ---"
  sqlite3 -header -column "$DB" "SELECT ticket,branch,status FROM attempts WHERE train_branch='$train' ORDER BY ticket,attempt_no;"
  echo "--- train head (CI-relevant) ---"
  git rev-parse "$train" 2>/dev/null || echo "train branch $train not present locally"
}

cmd_release_merge_cli() {
  local ticket="${1:-}"
  [ -n "$ticket" ] || { echo "usage: factory-dispatch release merge <ticket>" >&2; exit 1; }
  db_init
  local train; train="$(open_train)"
  [ -n "$train" ] || { echo "release: no open train" >&2; exit 1; }
  local tbranch
  tbranch="$(sqlite3 "$DB" "SELECT branch FROM attempts WHERE ticket=$ticket AND train_branch='$train' ORDER BY id DESC LIMIT 1;")"
  [ -n "$tbranch" ] || tbranch="$(sqlite3 "$DB" "SELECT branch FROM attempts WHERE ticket=$ticket ORDER BY id DESC LIMIT 1;")"
  [ -n "$tbranch" ] || { echo "release: no recorded branch for ticket #$ticket" >&2; exit 1; }
  train_merge "$ticket" "$tbranch" "$train"
}

cmd_release_drop() {
  local ticket="${1:-}"
  [ -n "$ticket" ] || { echo "usage: factory-dispatch release drop <ticket>" >&2; exit 1; }
  db_init
  local train; train="$(open_train)"
  [ -n "$train" ] || { echo "release: no open train" >&2; exit 1; }
  local twt; twt="$(train_worktree)"
  ensure_train_worktree "$train" || exit 1
  # Newest non-reverted merge for this ticket: a merge whose subject already
  # has a descendant Revert was dropped before — keep looking older.
  local merge_sha="" cand subject rsha
  for cand in $(git -C "$twt" log --format=%H --merges --grep="Merge ticket #${ticket} " "$train" 2>/dev/null || true); do
    subject="$(git -C "$twt" log -1 --format=%s "$cand")"
    rsha="$(git -C "$twt" log --format=%H --fixed-strings --grep="Revert \"$subject\"" "$train" 2>/dev/null | head -n 1 || true)"
    if [ -n "$rsha" ] && git -C "$twt" merge-base --is-ancestor "$cand" "$rsha" 2>/dev/null; then
      continue
    fi
    merge_sha="$cand"
    break
  done
  if [ -z "$merge_sha" ]; then
    echo "release: ticket #$ticket is NOT merged into $train (or already dropped) — nothing to drop" >&2
    exit 1
  fi
  if ! git -C "$twt" revert -m 1 --no-edit "$merge_sha" 2>&1; then
    git -C "$twt" revert --abort 2>/dev/null || true
    echo "release: revert of #$ticket conflicted — aborted" >&2
    exit 1
  fi
  echo "release: ticket #$ticket dropped from $train (revert $(git -C "$twt" rev-parse --short HEAD))"
}

cmd_once() {
  [ -f "$STOP_FILE" ] && { echo "dispatch: STOP file present — exiting"; exit 0; }
  db_init
  local train; train="$(open_train)"
  [ -n "$train" ] && echo "dispatch: open train $train — worktrees base on train head"
  local running; running="$(active_count)"
  if [ "$running" -ge "$MAX_CONCURRENT" ]; then echo "dispatch: $running active, at capacity — exiting"; exit 0; fi

  local candidates; candidates="$(gh issue list --state open --label ticket --limit 30 --json number 2>/dev/null --jq '.[].number')"
  [ -z "$candidates" ] && { echo "dispatch: no open tickets"; exit 0; }

  for ticket in $candidates; do
    DISPATCH_ATTEMPT_ID=""
    [ "$(active_count)" -ge "$MAX_CONCURRENT" ] && { echo "dispatch: capacity reached"; exit 0; }
    local info; info="$(issue_json "$ticket")"
    local labels title body
    labels="$(labels_of "$info")"
    has_label "$labels" "blocked" && { echo "dispatch: #$ticket blocked — skip"; continue; }
    has_label "$labels" "ready" || { echo "dispatch: #$ticket not ready — skip"; continue; }
    [ "$(ticket_active "$ticket")" -gt 0 ] && { echo "dispatch: #$ticket already active — skip (if no dispatcher is running, release the stuck lease with: sqlite3 $DB \"$(lease_recovery_sql)\")"; continue; }
    local att; att="$(ticket_attempts "$ticket")"
    [ "$att" -ge "$MAX_ATTEMPTS" ] && {
      echo "dispatch: #$ticket exhausted ($att attempts) — labelling blocked"
      [ "$DRY_RUN" = 1 ] || {
        gh issue comment "$ticket" --body "DISPATCH: attempt budget exhausted ($att/$MAX_ATTEMPTS). Human decision required." >/dev/null
        gh issue edit "$ticket" --remove-label ready --add-label blocked >/dev/null
      }
      continue
    }
    title="$(echo "$info" | python3 -c "import json,sys; print(json.load(sys.stdin)['title'])")"
    body="$(echo "$info" | python3 -c "import json,sys; print(json.load(sys.stdin)['body'])")"
    local open_deps; open_deps="$(depends_open "$body")"
    if [ -n "$open_deps" ]; then echo "dispatch: #$ticket waiting on open deps: $(echo "$open_deps" | tr '\n' ' ')— skip"; continue; fi

    local spec; spec="$(echo "$body" | grep -oE "Spec( issue)?:? #[0-9]+" | grep -oE "#[0-9]+" | tr -d '#' | head -n 1 || true)"
    local slug branch wt log id base
    slug="$(slug_of "$title")"
    branch="factory/T${ticket}-${slug}"
    wt="../${REPO_NAME}-T${ticket}"
    log="$LOG_DIR/T${ticket}-a$((att + 1))-impl.log"
    echo "dispatch: #$ticket '$title' (attempt $((att + 1)))"
    if [ "$DRY_RUN" = 1 ]; then echo "  dry-run: would build $branch @ $wt, run $PI_BIN -p, verify, review"; continue; fi

    git fetch origin dev --quiet 2>/dev/null || true
    if [ -n "$train" ]; then
      base="$(git rev-parse "$train")"
    else
      base="$(git rev-parse origin/dev 2>/dev/null || git rev-parse HEAD)"
    fi
    # Worktree BEFORE lease (ticket #75): the attempt row is activated only
    # after the directory is verified present, so every early exit below
    # either records a terminal state or never activated.
    if ! ensure_worktree "$wt" "$branch" "$base"; then
      echo "  worktree unavailable for #$ticket (branch checked out elsewhere?) — releasing for retry; inspect with: git worktree prune && git worktree list" 
      continue
    fi
    if [ ! -d "$wt" ]; then
      echo "  worktree $wt still absent after add — releasing #$ticket for retry"
      continue
    fi
    id="$(new_attempt "$ticket" "$((att + 1))" "$base" "$branch" "$wt" "$log")"
    DISPATCH_ATTEMPT_ID="$id"
    [ -n "$train" ] && set_train "$id" "$train"

    # --- freeze check on linked spec ---
    if [ -n "$spec" ]; then
      if ! FACTORY_SRC="" "$ROOT/scripts/factory" verify-freeze "$spec" >>"$log" 2>&1; then
        echo "  spec #$spec freeze mismatch — needs re-freeze, releasing ticket"
        set_status "$id" "impl_failed"
        gh issue comment "$ticket" --body "DISPATCH: linked spec #$spec body no longer matches its SPEC-APPROVED hash. Human must re-freeze before this ticket runs." >/dev/null
        git worktree remove --force "$wt" || true
        continue
      fi
    fi

    # --- implement (every write guarded: a failed redirection must settle
    # the attempt, never kill the pass under set -e holding impl_running) ---
    if ! {
      echo "Ticket issue: #$ticket"; echo "Spec issue: #${spec:-none}"
      echo "Branch: $branch (base $base)"; echo ""
      echo "$body"
    } > "$wt/.factory-brief.md"; then
      echo "  brief write to $wt failed — settling attempt, releasing ticket"
      set_status "$id" "impl_failed"
      gh issue comment "$ticket" --body "DISPATCH: implementer setup failed (cannot write $wt/.factory-brief.md, attempt $((att + 1))/$MAX_ATTEMPTS)." >/dev/null
      git worktree remove --force "$wt" || true
      continue
    fi
    if ! cat "$ROOT/.pi/prompts/build.md" "$wt/.factory-brief.md" > "$wt/.factory-prompt.md"; then
      echo "  prompt compose for $wt failed — settling attempt, releasing ticket"
      set_status "$id" "impl_failed"
      gh issue comment "$ticket" --body "DISPATCH: implementer setup failed (cannot compose prompt, attempt $((att + 1))/$MAX_ATTEMPTS)." >/dev/null
      git worktree remove --force "$wt" || true
      continue
    fi
    echo "  implement: $PI_BIN -p (timeout ${TIMEOUT_IMPL}s)"
    local code=0
    (cd "$wt" && timeout "$TIMEOUT_IMPL" $PI_BIN -p "$(cat .factory-prompt.md)" >>"$log" 2>&1) || code=$?
    if [ "$code" -ne 0 ]; then
      echo "  implement exited $code — will retry next pass"
      set_status "$id" "impl_failed"
      gh issue comment "$ticket" --body "DISPATCH: implementer exited $code (attempt $((att + 1))/$MAX_ATTEMPTS). Log tail kept in dispatcher state." >/dev/null
      continue
    fi

    # --- verify ---
    echo "  verify: scripts/factory-check"
    if ! (cd "$wt" && ./scripts/factory-check >>"$log" 2>&1); then
      echo "  checks FAILED — routing back (log tail posted)"
      set_status "$id" "impl_failed"
      { echo "DISPATCH: factory-check failed (attempt $((att + 1))/$MAX_ATTEMPTS). Tail:"; echo '```'; tail -n 30 "$log"; echo '```'; } > /tmp/disp-fail.md
      gh issue comment "$ticket" --body-file /tmp/disp-fail.md >/dev/null
      continue
    fi

    # --- evidence: HANDOFF.md goes to the issue, scaffolding never commits ---
    # Root-cause fix: dispatcher-owned files must not reach the ticket branch.
    local handoff_text=""
    if [ -f "$wt/HANDOFF.md" ]; then
      handoff_text="$(cat "$wt/HANDOFF.md")"
      gh issue comment "$ticket" --body-file "$wt/HANDOFF.md" >/dev/null
      echo "  handoff posted to #$ticket"
    fi
    rm -f "$wt/.factory-brief.md" "$wt/.factory-prompt.md" "$wt/HANDOFF.md"

    # --- head must exist (allow-empty when the handoff proves side-effect work) ---
    local head cur
    cur="$(git -C "$wt" rev-parse HEAD)"
    git -C "$wt" add -A 2>/dev/null || true
    if git -C "$wt" diff --cached --quiet && [ "$cur" = "$base" ]; then
      # Nothing staged and no prior implementer commit: only proceed if the
      # implementer left HANDOFF.md (empty-change handoff); else release.
      if [ -n "$handoff_text" ]; then
        git -C "$wt" -c user.name="factory-dispatch" -c user.email="factory@local" commit --allow-empty -qm "feat(T${ticket}): ${title} [handoff-only]" 2>/dev/null || true
        head="$(git -C "$wt" rev-parse HEAD)"
      else
        head="$base"
      fi
    elif git -C "$wt" diff --cached --quiet; then
      # Implementer already committed (possibly --allow-empty); keep its head.
      head="$cur"
    else
      git -C "$wt" -c user.name="factory-dispatch" -c user.email="factory@local" commit -qm "feat(T${ticket}): ${title}" 2>/dev/null || true
      head="$(git -C "$wt" rev-parse HEAD)"
    fi
    set_head "$id" "$head" 0
    if [ "$head" = "$base" ]; then
      echo "  no changes produced — releasing"
      set_status "$id" "impl_done"
      gh issue comment "$ticket" --body "DISPATCH: implementer produced no changes. Human decision required." >/dev/null
      git worktree remove --force "$wt"
      continue
    fi
    set_status "$id" "impl_done"
    gh issue edit "$ticket" --remove-label ready --add-label review >/dev/null

    # --- review (separate detached worktree, reviewer writes file, dispatcher posts) ---
    local rwt="../${REPO_NAME}-review-${head:0:8}" report="/tmp/T${ticket}-review.md"
    if ! git worktree add --detach "$rwt" "$head" 2>&1 | tail -n 1; then
      echo "  review worktree failed — routing back to ready"
      set_status "$id" "review_failed"
      gh issue edit "$ticket" --remove-label review --add-label ready >/dev/null
      gh issue comment "$ticket" --body "DISPATCH: review setup failed (cannot cut review worktree, attempt $((att + 1))/$MAX_ATTEMPTS)." >/dev/null
      git worktree remove --force "$wt" || true
      continue
    fi
    sqlite3 "$DB" "UPDATE attempts SET status='review_running' WHERE id=$id;"
    {
      echo "Repo worktree: $rwt"; echo "BASE_COMMIT: $base"; echo "HEAD_COMMIT: $head"
      echo "Ticket issue: #$ticket. Spec issue: #${spec:-none} (verify freeze before starting)."
      echo "Write the FULL report to $report. End stdout with: VERDICT: accept|changes_requested"
      echo ""
      if [ -n "$handoff_text" ]; then
        echo "--- implementer HANDOFF (posted to the issue; verify its claims, do not trust them) ---"
        printf '%s\n' "$handoff_text"
        echo "--- end HANDOFF ---"
        echo ""
      fi
      cat "$ROOT/.pi/prompts/review.md"
    } > "$rwt/.factory-review-brief.md"
    echo "  review: $PI_BIN -p (timeout ${TIMEOUT_REVIEW}s)"
    (cd "$rwt" && timeout "$TIMEOUT_REVIEW" $PI_BIN -p "$(cat .factory-review-brief.md)" >>"$LOG_DIR/T${ticket}-a$((att + 1))-review.log" 2>&1) || true
    local verdict; verdict="$(tail -n 5 "$LOG_DIR/T${ticket}-a$((att + 1))-review.log" | grep -oE "VERDICT: (accept|changes_requested)" | tail -n 1 | awk '{print $2}')"
    if [ -f "$report" ]; then
      gh issue comment "$ticket" --body-file "$report" >/dev/null
    else
      gh issue comment "$ticket" --body "DISPATCH: reviewer produced no report file. Verdict line: ${verdict:-none}. Review log kept in dispatcher state." >/dev/null
    fi
    git worktree remove --force "$rwt" || true
    git worktree prune 2>/dev/null || true
    if [ "$verdict" = "accept" ]; then
      if [ -n "$train" ]; then
        # Accept-path auto-merge into the train: clean merges only.
        # Conflict (or any merge failure) routes to blocked — never forced.
        if train_merge "$ticket" "$branch" "$train"; then
          set_status "$id" "review_done"
          gh issue edit "$ticket" --remove-label review --add-label integrated >/dev/null
          gh issue comment "$ticket" --body "DISPATCH: review accepted; merged into train \`$train\` ($(git rev-parse --short "$train")). Human: covered by the train→dev review." >/dev/null
          echo "  ACCEPTED + INTEGRATED into $train — #$ticket"
        else
          echo "  merge into train failed — routing to blocked (never forced)"
          set_status "$id" "review_failed"
          gh issue edit "$ticket" --remove-label review --add-label blocked >/dev/null
          gh issue comment "$ticket" --body "DISPATCH: review accepted but merge into train \`$train\` failed (conflict or dirty train) — merge aborted, nothing forced. Human: resolve, or \`release drop $ticket\`." >/dev/null
        fi
      else
        set_status "$id" "review_done"
        gh issue edit "$ticket" --remove-label review --add-label accepted >/dev/null
        gh issue comment "$ticket" --body "DISPATCH: review accepted. Base \`$base\` → head \`$head\` on \`$branch\`. Human: verify and /land." >/dev/null
        echo "  ACCEPTED — #$ticket awaiting human land"
      fi
    else
      echo "  changes_requested (or unreadable verdict) — back to ready"
      set_status "$id" "review_failed"
      gh issue edit "$ticket" --remove-label review --add-label ready >/dev/null
    fi
  done
  echo "dispatch: pass complete"
}

cmd_selftest() {
  # Hermetic proof of release mechanics: temp project + bare origin, no gh,
  # no network, no tokens. Exercises: release start, merge, status, drop,
  # drop-idempotence refusal, conflict-abort, two-open-trains refusal.
  local tmp; tmp="$(mktemp -d)/selftest"
  mkdir -p "$tmp/origin.git" "$tmp/proj"
  git init --bare -q "$tmp/origin.git"
  git init -q "$tmp/proj" && echo 'factory/.state/' > "$tmp/proj/.gitignore" && git -C "$tmp/proj" add .gitignore && git -C "$tmp/proj" commit -q -m init
  git -C "$tmp/proj" remote add origin "$tmp/origin.git"
  git -C "$tmp/proj" branch -M dev && git -C "$tmp/proj" push -q origin dev
  export ROOT="$tmp/proj"
  STATE_DIR="$ROOT/factory/.state" DB="$STATE_DIR/dispatch.db" LOG_DIR="$STATE_DIR/logs" STOP_FILE="$STATE_DIR/STOP"
  REPO_NAME="selftest"
  local fail=0
  check() { if [ "$2" = "$3" ]; then echo "PASS: $1"; else echo "FAIL: $1 (want [$3] got [$2])"; fail=1; fi; }
  (cd "$ROOT" && cmd_release_start proof >/dev/null)
  local train; train="$(open_train)"
  check "start cuts train" "$train" "integration/$(date +%Y%m%d)-proof"
  (cd "$ROOT" && cmd_release_start again 2>/dev/null) && check "second train refused" "opened" "refused" || check "second train refused" "refused" "refused"
  git -C "$ROOT" checkout -qb factory/T1-demo && echo x > "$ROOT/f.txt" && git -C "$ROOT" add -A && git -C "$ROOT" commit -qm feat && git -C "$ROOT" checkout -q dev
  sqlite3 "$DB" "INSERT INTO attempts(ticket,attempt_no,branch,status) VALUES(1,1,'factory/T1-demo','impl_done');"
  sqlite3 "$DB" "UPDATE attempts SET train_branch='$train' WHERE ticket=1;"
  (cd "$ROOT" && cmd_release_merge_cli 1 >/dev/null) && check "merge clean" "merged" "merged" || check "merge clean" "failed" "merged"
  git -C "$(train_worktree)" log --oneline "$train" | grep -q "Merge ticket #1" && check "merge commit present" "yes" "yes" || check "merge commit present" "no" "yes"
  (cd "$ROOT" && cmd_release_drop 1 >/dev/null) && check "drop reverts" "dropped" "dropped" || check "drop reverts" "failed" "dropped"
  (cd "$ROOT" && cmd_release_drop 1 2>/dev/null) && check "double-drop refused" "dropped-twice" "refused" || check "double-drop refused" "refused" "refused"
  git -C "$ROOT" checkout -qb factory/T2-conf && echo a > "$ROOT/c.txt" && git -C "$ROOT" add -A && git -C "$ROOT" commit -qm feat && git -C "$ROOT" checkout -q dev
  git -C "$(train_worktree)" checkout -q "$train" && echo b > "$(train_worktree)/c.txt" && git -C "$(train_worktree)" add -A && git -C "$(train_worktree)" commit -qm train-side
  sqlite3 "$DB" "INSERT INTO attempts(ticket,attempt_no,branch,status,train_branch) VALUES(2,1,'factory/T2-conf','impl_done','$train');"
  (cd "$ROOT" && cmd_release_merge_cli 2 2>/dev/null) && check "conflict aborts" "merged" "aborted" || check "conflict aborts" "aborted" "aborted"
  git -C "$(train_worktree)" status --porcelain | grep -q . && check "train clean after abort" "dirty" "clean" || check "train clean after abort" "clean" "clean"
  (cd "$ROOT" && cmd_release_status >/dev/null) && check "status runs" "ok" "ok" || check "status runs" "broken" "ok"
  rm -rf "$tmp"
  [ "$fail" = 0 ] && echo "SELF-TEST ALL PASS" || { echo "SELF-TEST FAILURES"; exit 1; }
}

cmd_status() {
  db_init
  sqlite3 -header -column "$DB" "SELECT id,ticket,attempt_no,status,substr(base_commit,1,8),substr(head_commit,1,8),started_at FROM attempts ORDER BY id DESC LIMIT 20;"
  echo "--- worktrees ---"; git worktree list 2>/dev/null
  [ -f "$STOP_FILE" ] && echo "STOPPED (STOP file present)" || echo "running (no STOP file)"
}

case "${1:-}" in
  once) shift; [ "${1:-}" = "--dry-run" ] && DRY_RUN=1; cmd_once ;;
  daemon) shift; interval="${2:-300}"; db_init; echo "dispatch daemon every ${interval}s (STOP with: $0 stop)"; while true; do cmd_once; sleep "$interval"; done ;;
  status) cmd_status ;;
  self-test) cmd_selftest ;;
  stop) mkdir -p "$STATE_DIR"; touch "$STOP_FILE"; echo stopped ;;
  resume) rm -f "$STOP_FILE"; echo resumed ;;
  release)
    cmd="${2:-}"; arg="${3:-}"
    case "$cmd" in
      start) cmd_release_start "$arg" ;;
      status) cmd_release_status ;;
      merge) cmd_release_merge_cli "$arg" ;;
      drop) cmd_release_drop "$arg" ;;
      *) echo "usage: factory-dispatch release {start [slug]|status|merge <ticket>|drop <ticket>}" >&2; exit 1 ;;
    esac ;;
  *) usage; exit 1 ;;
esac
