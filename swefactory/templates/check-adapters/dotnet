#!/usr/bin/env bash
# factory-check (dotnet) — check adapter for .NET projects.
# Contract: format check -> lint/compile -> tests; exit non-zero on ANY
# failure; print FACTORY-CHECK PASSED only on success. Extra args pass
# through to the test runner. FACTORY_SLOT offsets concurrent state so
# parallel dispatcher workers never share mutable resources.
set -euo pipefail

cd "${0%/*}/.."

has_project=0
for f in *.csproj *.sln; do
  if [ -e "$f" ]; then has_project=1; break; fi
done

if [ "$has_project" = 0 ] && [ ! -f global.json ]; then
  echo "factory-check: no .csproj/.sln yet — nothing to check"
  echo "FACTORY-CHECK PASSED"
  exit 0
fi

# Slot isolation: separate temp state per dispatcher worker.
if [ -n "${FACTORY_SLOT:-}" ]; then
  export TMPDIR="${TMPDIR:-/tmp}/factory-slot-$FACTORY_SLOT"
  mkdir -p "$TMPDIR"
fi

have() { command -v "$1" >/dev/null 2>&1; }
note() { echo "(skip: $1)"; }

if ! have dotnet; then
  echo "factory-check: .NET project found but the dotnet SDK is not installed" >&2
  exit 1
fi

echo "==> dotnet format"
dotnet format --verify-no-changes --verbosity quiet

echo "==> dotnet build"
dotnet build --nologo

echo "==> dotnet test"
dotnet test --nologo "$@"

echo "FACTORY-CHECK PASSED"
