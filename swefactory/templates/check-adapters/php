#!/usr/bin/env bash
# factory-check (php) — check adapter for PHP (Composer) projects.
# Contract: format check -> lint/compile -> tests; exit non-zero on ANY
# failure; print FACTORY-CHECK PASSED only on success. Extra args pass
# through to the test runner. FACTORY_SLOT offsets concurrent state so
# parallel dispatcher workers never share mutable resources.
set -euo pipefail

cd "${0%/*}/.."

if [ ! -f composer.json ]; then
  echo "factory-check: no composer.json yet — nothing to check"
  echo "FACTORY-CHECK PASSED"
  exit 0
fi

# Slot isolation: separate temp state per dispatcher worker.
if [ -n "${FACTORY_SLOT:-}" ]; then
  export TMPDIR="${TMPDIR:-/tmp}/factory-slot-$FACTORY_SLOT"
  mkdir -p "$TMPDIR"
fi

have() { command -v "$1" >/dev/null 2>&1; }
note() { echo "(skip: $1)"; }

if ! have php; then
  echo "factory-check: composer.json found but php is not installed" >&2
  exit 1
fi

echo "==> pint --test"
if [ -x vendor/bin/pint ]; then
  vendor/bin/pint --test
elif [ -x vendor/bin/php-cs-fixer ]; then
  PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer fix --dry-run --diff
else
  note "pint/php-cs-fixer not installed"
fi

echo "==> phpstan"
if [ -x vendor/bin/phpstan ]; then
  vendor/bin/phpstan analyse
elif [ -x vendor/bin/psalm ]; then
  vendor/bin/psalm --no-cache
else
  note "phpstan/psalm not installed"
fi

echo "==> phpunit"
if [ -x vendor/bin/phpunit ]; then
  vendor/bin/phpunit "$@"
else
  note "phpunit not installed"
fi

echo "FACTORY-CHECK PASSED"
