#!/usr/bin/env bash
# Factory gate (python adapter). Contract: format check → lint → tests; non-zero exit on failure.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== lint =="
ruff check . 2>/dev/null || python -m flake8 . 2>/dev/null || echo "(no linter configured — add one)"

echo "== test =="
pytest "$@"

echo "FACTORY-CHECK PASSED"
