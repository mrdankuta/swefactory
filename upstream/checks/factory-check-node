#!/usr/bin/env bash
# Factory gate (node adapter). Contract: format check → lint → tests; non-zero exit on failure.
# Concurrency: FACTORY_SLOT (1..N) is set per dispatcher worker — offset any
# ports/tmpdirs with it, e.g. PORT=$((3000 + ${FACTORY_SLOT:-0})).
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== lint =="
npm run lint --if-present

echo "== test =="
npm test

echo "FACTORY-CHECK PASSED"
