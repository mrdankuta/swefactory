#!/usr/bin/env bash
# Factory gate: one deterministic command humans and agents run before handoff.
# Contract (all stack adapters): format check → lint/compile → tests; non-zero exit on failure.
# Concurrency: factory-dispatch exports FACTORY_SLOT (1..N) per attempt —
# concurrent workers MUST NOT share mutable resources (test DBs, ports).
set -euo pipefail
cd "$(dirname "$0")/.."

if [ -n "${FACTORY_SLOT:-}" ]; then
  export MIX_TEST_PARTITION="$FACTORY_SLOT"  # separate test DB per slot
  echo "(slot $FACTORY_SLOT → MIX_TEST_PARTITION=$FACTORY_SLOT)"
fi

echo "== format =="
mix format --check-formatted

echo "== compile (warnings as errors) =="
mix compile --warnings-as-errors

echo "== test =="
MIX_ENV=test mix test "$@"

echo "== assets =="
mix assets.build

echo "FACTORY-CHECK PASSED"
